{
  "name": "multi-resolution-timeseries-parquet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Serve years of high-frequency time-series to a browser chart — no backend, no database. Multi-resolution Parquet tiers + HTTP range requests.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "seed": "tsx scripts/seed.ts",
    "unpack": "tsx scripts/unpack.ts",
    "generate": "tsx scripts/generate.ts",
    "reset": "tsx scripts/reset.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hyparquet": "1.29.1",
    "hyparquet-writer": "0.16.6",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.x"
  }
}
